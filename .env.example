# Provider: deepseek | openai
# Agent runtime:
#   chat_json = existing API JSON loop (kept as an ablation)
#   codex_cli = persistent Codex Plus coding-agent thread; no API key is used
ARC_AGENT_RUNTIME=chat_json
# Default true preserves the project's .env-first behavior. Set false only in
# a deliberately configured process whose environment must override .env.
# ARC_DOTENV_OVERRIDE=false
# ARC_CODEX_EXECUTABLE=codex
# ARC_CODEX_CLI_TIMEOUT_SECONDS=900
# ARC_CODEX_POST_TURN_EXIT_GRACE_SECONDS=10
# ARC_CODEX_MAX_TURNS_PER_THREAD=4
# ARC_CODEX_ROLLOVER_PROMPT_TOKENS=450000
# ARC_CODEX_COMPOUND_CYCLE=true
# For gpt-5.6-sol set:
#   ARC_MODEL_PROVIDER=openai
#   OPENAI_API_KEY=...
#   DEEPSEEK_MODEL=gpt-5.6-sol
#   Official OpenAI: DEEPSEEK_BASE_URL=https://api.openai.com/v1 + OPENAI key
#   AIhubmix:        DEEPSEEK_BASE_URL=https://api.inferera.com/v1 (or https://aihubmix.com/v1)
#                    + AIhubmix key in OPENAI_API_KEY
#   DEEPSEEK_REASONING_EFFORT=medium   # use xhigh only with $100+ budget
#   pricing 5.0 / 0.5 / 30.0           # adjust if relay markup differs
#   ARC_MAX_SPEND_USD=55
ARC_MODEL_PROVIDER=openai
ARC_API_KEY_ENV=OPENAI_API_KEY

DEEPSEEK_API_KEY=
OPENAI_API_KEY=replace-with-your-key
DEEPSEEK_BASE_URL=https://api.inferera.com/v1
DEEPSEEK_MODEL=gpt-5.6-sol
DEEPSEEK_THINKING_MODE=disabled
DEEPSEEK_REASONING_EFFORT=medium
DEEPSEEK_TEMPERATURE=0
DEEPSEEK_TIMEOUT_SECONDS=180
DEEPSEEK_MAX_RETRIES=1
DEEPSEEK_SEED=
DEEPSEEK_MAX_OUTPUT_TOKENS=8192
DEEPSEEK_BASELINE_MAX_OUTPUT_TOKENS=1024
DEEPSEEK_WORLD_MODEL_MAX_OUTPUT_TOKENS=8192
DEEPSEEK_CONTEXT_TRANSITIONS=16
DEEPSEEK_VISION_ENABLED=false

# gpt-5.6-sol list price (short context)
DEEPSEEK_INPUT_COST_PER_MILLION=5.0
DEEPSEEK_CACHED_INPUT_COST_PER_MILLION=0.5
DEEPSEEK_OUTPUT_COST_PER_MILLION=30.0

ARC_GAME_ID=ls20
ARC_RUNS=1
ARC_MAX_ENVIRONMENT_ACTIONS=12
# Direct baseline actions returned per model call. 1 is the legacy baseline;
# the preregistered batched direct baseline uses 16.
ARC_BASELINE_MAX_BATCH_ACTIONS=1
ARC_SCHEMA_SEEDS=0
ARC_OUTPUT_DIR=pilot-runs
ARC_OPERATION_MODE=offline
ARC_RENDER_MODE=
ARC_PLANNER_MAX_NODES=5000
ARC_HARNESS_MODEL_ATTEMPTS=2
ARC_EXPLORE_STEPS=8
ARC_MAX_PLAN_STEPS=16
ARC_EXPLORE_BURST=3
ARC_WM_TIME_RESERVE_SECONDS=180
ARC_RUN_TIMEOUT_SECONDS=1800
ARC_MAX_MODEL_CALLS_PER_RUN=120
ARC_MAX_TOTAL_TOKENS_PER_RUN=0
# Subscription-backed Codex runs use these reproducible resource caps.  A cap
# stops the next call; it cannot interrupt tokens already being generated.
ARC_MAX_UNCACHED_TOKENS_PER_RUN=0
ARC_MAX_OUTPUT_TOKENS_PER_RUN=0
ARC_TOKEN_RESERVE_PER_CALL=0
# Cost proxy from the configured token rates; not a Codex Plus invoice/spend cap.
ARC_MAX_NOTIONAL_COST_USD=0
ARC_HARNESS_MODE=schema
ARC_DELIBERATION_MAX_TURNS=16
# Schema-faithful mainline settings:
ARC_SCHEMA_COMMIT_ONLY=false
ARC_ALLOW_APPROXIMATE_VISUAL_MATCHES=false
# Stop immediately after this many completed levels (0 disables target stop).
ARC_TARGET_LEVELS_COMPLETED=0
ARC_MAX_SPEND_USD=0
ARC_AUTO_RESET_ON_GAME_OVER=true
ARC_MAX_GAME_OVER_RESETS=10
