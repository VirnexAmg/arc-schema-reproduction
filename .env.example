DEEPSEEK_API_KEY=replace-with-your-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=replace-with-exact-model-id
DEEPSEEK_THINKING_MODE=disabled
DEEPSEEK_REASONING_EFFORT=high
DEEPSEEK_TEMPERATURE=0
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_MAX_RETRIES=1
DEEPSEEK_SEED=0
DEEPSEEK_MAX_OUTPUT_TOKENS=4096
DEEPSEEK_BASELINE_MAX_OUTPUT_TOKENS=512
DEEPSEEK_WORLD_MODEL_MAX_OUTPUT_TOKENS=4096
DEEPSEEK_CONTEXT_TRANSITIONS=12
DEEPSEEK_VISION_ENABLED=false

# Optional. Leave blank rather than guessing current provider pricing.
DEEPSEEK_INPUT_COST_PER_MILLION=
DEEPSEEK_CACHED_INPUT_COST_PER_MILLION=
DEEPSEEK_OUTPUT_COST_PER_MILLION=

ARC_GAME_ID=ls20
ARC_RUNS=1
ARC_MAX_ENVIRONMENT_ACTIONS=3
ARC_SCHEMA_SEEDS=0
ARC_OUTPUT_DIR=runs
ARC_OPERATION_MODE=offline
ARC_RENDER_MODE=
ARC_PLANNER_MAX_NODES=1000
ARC_HARNESS_MODEL_ATTEMPTS=2
ARC_EXPLORE_STEPS=6
ARC_MAX_PLAN_STEPS=3
ARC_RUN_TIMEOUT_SECONDS=600
ARC_MAX_MODEL_CALLS_PER_RUN=40
